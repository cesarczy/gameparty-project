{
  "name": "gameparty",
  "version": "0.1.0",
  "private": true,
  "description": "Chat ao vivo para encontrar companhia de jogos — gameparty.com.br",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "harness": "./harness/scripts/run-harness.sh",
    "docker:up": "./docker/dev.sh up",
    "docker:down": "./docker/dev.sh down",
    "docker:logs": "./docker/dev.sh logs",
    "docker:test": "./docker/dev.sh test",
    "docker:reset": "./docker/dev.sh reset"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "google-auth-library": "^9.15.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
