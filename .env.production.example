# Copie para .env na VPS: cp .env.production.example .env
# NUNCA commite o .env de produção.

# --- Domínio ---
# URL pública do site (sem barra no final)
CORS_ORIGIN=https://gameparty.com.br

# --- PostgreSQL (container interno) ---
POSTGRES_USER=gameparty
POSTGRES_PASSWORD=troque-por-senha-forte-aqui
POSTGRES_DB=gameparty

# --- API ---
JWT_SECRET=troque-por-segredo-longo-minimo-16-caracteres
LOG_LEVEL=info
ROOM_MESSAGE_RETENTION_DAYS=90
MESSAGE_PURGE_INTERVAL_HOURS=24

# --- Admin inicial (seed) ---
# Só na primeira subida: RUN_SEED=true
RUN_SEED=true
ADMIN_EMAIL=admin@gameparty.com.br
ADMIN_PASSWORD=troque-senha-admin-forte

# --- Google OAuth (opcional) ---
# Mesmo valor usado no build do frontend (nginx)
GOOGLE_CLIENT_ID=

# --- Porta HTTP exposta pelo nginx ---
HTTP_PORT=80

# Google Cloud Console → OAuth Web:
# Origens: https://gameparty.com.br
# Redirect: https://gameparty.com.br
